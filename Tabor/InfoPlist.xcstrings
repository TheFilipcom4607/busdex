{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TABOR reads the fleet number off buses and trams you point it at."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TABOR odczytuje numery taborowe autobusów i tramwajów, na które skierujesz aparat."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the buses and trams running near you on HUNT, and geotags your catches for your spotting map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje w HUNT autobusy i tramwaje jeżdżące w pobliżu i zaznacza miejsca złapań na twojej mapie."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the full-resolution shot of each catch to your Photos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje pełnowymiarowe zdjęcie każdego złapanego pojazdu w Zdjęciach."
          }
        }
      }
    }
  },
  "version": "1.0"
}
