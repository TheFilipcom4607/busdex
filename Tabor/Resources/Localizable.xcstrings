    "Swipe down from the top-right corner.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń palcem w dół od prawego górnego rogu."
          }
        }
      }
    },
    "Swipe to Controls, then choose Catch a vehicle.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przewiń do sterowania i wybierz Złap pojazd."
          }
        }
      }
    },
    "TABOR": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TABOR"
          }
        }
      }
    },
    "TABOR has a Catch button for your Lock Screen, Control Center and Action button. It opens straight to the camera, even from a locked phone. There's a Hunt button too, for the live map.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TABOR ma przycisk Złap na ekran blokady, do centrum sterowania i pod przycisk akcji. Od razu otwiera aparat, nawet na zablokowanym telefonie. Jest też przycisk Poluj, do mapy na żywo."
          }
        }
      }
    },
    "TABOR's server": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer TABORU"
          }
        }
      }
    },
