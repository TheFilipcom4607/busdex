    "The city's feed sent something unreadable.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejski serwer przysłał coś nieczytelnego."
          }
        }
      }
    },
    "The downloaded data was broken.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrane dane były uszkodzone."
          }
        }
      }
    },
    "The only vehicle of its kind in Warsaw": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedyny taki pojazd w Warszawie"
          }
        }
      }
    },
