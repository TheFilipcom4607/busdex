    "Seen it before — that's sighting #%lld of %@. It still counts toward your streak.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Seen it before — that's sighting #%1$lld of %2$@. It still counts toward your streak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już go masz — to twoja %1$lld. obserwacja #%2$@. Do serii i tak się liczy."
          }
        }
      }
    },
