    },
    "Thank you for testing TABOR 💛": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki za testowanie TABORU 💛"
          }
        }
      }
    },
    "That completes the %@ batch of %@. %lld left in other batches.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "That completes the %1$@ batch of %2$@. %3$lld left in other batches."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostawa %1$@ modelu %2$@ jest kompletna. W innych dostawach brakuje jeszcze %3$lld."
          }
        }
